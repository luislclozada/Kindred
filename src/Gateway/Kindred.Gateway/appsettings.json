{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:11200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "students": {
        "ClusterId": "student-service",
        "Match": { "Path": "/api/v1/students/{**rest}" }
      },
      "courses": {
        "ClusterId": "student-service",
        "Match": { "Path": "/api/v1/courses/{**rest}" }
      },
      "matching": {
        "ClusterId": "matching-service",
        "Match": { "Path": "/api/v1/matching/{**rest}" }
      }
    },
    "Clusters": {
      "student-service": {
        "Destinations": {
          "local": { "Address": "http://localhost:11101/" }
        }
      },
      "matching-service": {
        "Destinations": {
          "local": { "Address": "http://localhost:11102/" }
        }
      }
    }
  }
}
